APP_NAME="سامانه استعلامات"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tehran

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inquiries_gateway
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_DRIVER=database
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=900

ADMIN_NAME="مدیر سامانه"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Comma-separated host allowlist. Empty = any public host.
REMOTE_SERVICE_ALLOWED_HOSTS=
REMOTE_SERVICE_ALLOW_PRIVATE_NETWORKS=false
REMOTE_SERVICE_REQUIRE_HTTPS=true
REMOTE_SERVICE_ENFORCE_DNS_RESOLUTION=true
REMOTE_SERVICE_MAX_RESPONSE_BYTES=1048576
REMOTE_SERVICE_ASYNC=true
REMOTE_SERVICE_QUEUE=remote-services
